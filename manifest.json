{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "WiseNotes",
  "version": "0.3.0",
  "description": "Turn captioned YouTube lectures into a visually grounded LaTeX prompt for any capable LLM — wherever speech alone is lossy.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "WiseNotes"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["yt-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
